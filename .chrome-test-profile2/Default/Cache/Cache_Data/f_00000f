<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PhonixPaaS Dashboard — Self-Hosted Mobile PaaS</title>
  <link rel="icon" type="image/png" href="https://media.brand.dev/aabde5a6-1777-4ee0-9ba3-71d36b608de8.png">
  <link rel="stylesheet" href="css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://media.brand.dev" crossorigin>
  <!-- Neue Montreal Font Preloads (Render Official Typography) -->
  <link rel="preload" href="https://media.brand.dev/fonts/1a020a0ccc2b29ad091b713864b135d9f7fb6d3114e69620f6d56eeb9abefbcc.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="https://media.brand.dev/fonts/11a1b227a4f432bdc5587a529d34a46abbed7067b6e1fb913db0c489c7175828.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="https://media.brand.dev/fonts/dbe3ffb91c68d5dcda6a66581c481a69e96dabe1abc48c9fc8b80d64793589b1.woff2" as="font" type="font/woff2" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Noto+Color+Emoji&display=swap" rel="stylesheet">
</head>
<body class="render-app">
  <!-- FULL WEBSITE BACKGROUND ANIMATION (ThreeUI Signal Particles @ 0.20s) -->
  <div id="website-animation-bg" class="shader-frame" style="position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 0; pointer-events: none; overflow: hidden;">
    <iframe id="globalBgShaderIframe" src="/scene/?mode=light&speed=0.20" style="width: 100%; height: 100%; border: 0; display: block;" title="ThreeUI Signal Particles Background"></iframe>
  </div>

  <div class="render-layout" style="position: relative; z-index: 1;">
    
    <!-- LEFT SIDEBAR -->
    <aside class="rd-sidebar" id="appSidebar">
      <!-- Top Workspace Selector -->
      <div class="rd-sidebar-header">
        <div class="rd-logo" title="Render Design Language">
          <!-- Official Render organic glyph (brand.dev extraction) -->
          <svg width="22" height="22" viewBox="0 0 21 21" fill="currentColor">
            <path d="M15.6491 0.00582604C12.9679 -0.120371 10.7133 1.81847 10.3286 4.373C10.3134 4.49154 10.2905 4.60627 10.2715 4.72099C9.67356 7.90268 6.88955 10.3119 3.5457 10.3119C2.35364 10.3119 1.23395 10.006 0.258977 9.47058C0.140914 9.40557 0 9.4897 0 9.62354V10.3081V20.6218H10.2677V12.8894C10.2677 11.4668 11.4178 10.3119 12.8346 10.3119H15.4015C18.3074 10.3119 20.6458 7.89121 20.5315 4.94662C20.4287 2.29649 18.2884 0.132023 15.6491 0.00582604Z"/>
          </svg>
        </div>
        <div class="rd-workspace-selector" id="workspaceDropdown" onclick="switchView('settings')">
          <div class="rd-avatar-circle" id="workspaceAvatar">M</div>
          <span class="rd-workspace-name" id="workspaceTitle">My Workspace</span>
          <svg class="rd-chevron-updown" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M7 15l5 5 5-5M7 9l5-5 5 5"/>
          </svg>
        </div>
      </div>

      <!-- Navigation Links -->
      <nav class="rd-sidebar-nav">
        <!-- Section: OVERVIEW -->
        <div class="rd-nav-group">
          <a href="#dashboard" class="rd-nav-item active" data-view="dashboard">
            <svg class="rd-nav-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            <span>Dashboard & Health</span>
          </a>

          <a href="#projects" class="rd-nav-item" data-view="projects">
            <svg class="rd-nav-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="5" r="3"></circle>
              <circle cx="5" cy="19" r="3"></circle>
              <circle cx="19" cy="19" r="3"></circle>
              <line x1="12" y1="8" x2="5" y2="16"></line>
              <line x1="12" y1="8" x2="19" y2="16"></line>
            </svg>
            <span>Projects & Services</span>
          </a>
        </div>

        <!-- Section: DEPLOYMENTS -->
        <div class="rd-nav-section-title">DEPLOYMENTS & GIT</div>
        <div class="rd-nav-group">
          <a href="#deployments" class="rd-nav-item" data-view="deployments">
            <svg class="rd-nav-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
            <span>Deployments & Releases</span>
          </a>
        </div>

        <!-- Section: NETWORKING -->
        <div class="rd-nav-section-title">NETWORKING</div>
        <div class="rd-nav-group">
          <a href="#networking" class="rd-nav-item" data-view="networking">
            <svg class="rd-nav-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span>Tunnels, Domains & Ports</span>
          </a>
        </div>

        <!-- Section: MONITORING -->
        <div class="rd-nav-section-title">MONITORING</div>
        <div class="rd-nav-group">
          <a href="#monitoring" class="rd-nav-item" data-view="monitoring">
            <svg class="rd-nav-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
            </svg>
            <span>Hardware, Battery & Logs</span>
          </a>
        </div>

        <!-- Section: DEVELOPER TOOLS -->
        <div class="rd-nav-section-title">DEVELOPER TOOLS</div>
        <div class="rd-nav-group">
          <a href="#devtools" class="rd-nav-item" data-view="devtools">
            <svg class="rd-nav-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="4 17 10 11 4 5"></polyline>
              <line x1="12" y1="19" x2="20" y2="19"></line>
            </svg>
            <span>Console, Webhooks & Env</span>
          </a>
        </div>

        <!-- Section: INFRASTRUCTURE -->
        <div class="rd-nav-section-title">INFRASTRUCTURE</div>
        <div class="rd-nav-group">
          <a href="#infrastructure" class="rd-nav-item" data-view="infrastructure">
            <svg class="rd-nav-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
              <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
              <line x1="6" y1="6" x2="6.01" y2="6"></line>
              <line x1="6" y1="18" x2="6.01" y2="18"></line>
            </svg>
            <span>Node Specs & Power</span>
          </a>
        </div>

        <!-- Section: INTEGRATIONS -->
        <div class="rd-nav-section-title">INTEGRATIONS</div>
        <div class="rd-nav-group">
          <a href="#integrations" class="rd-nav-item" data-view="integrations">
            <svg class="rd-nav-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16.5 9.4 7.55 4.24a1.78 1.78 0 0 0-2.5 1.55v12.42a1.78 1.78 0 0 0 2.5 1.55L16.5 14.6a1.78 1.78 0 0 0 0-3.2z"></path>
            </svg>
            <span>Cloudflare, Git & DBs</span>
          </a>
        </div>

        <!-- Section: WORKSPACE -->
        <div class="rd-nav-section-title">SETTINGS</div>
        <div class="rd-nav-group">
          <a href="#settings" class="rd-nav-item" data-view="settings">
            <svg class="rd-nav-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
            <span>Platform Settings</span>
          </a>
        </div>
      </nav>

      <!-- Sidebar Footer -->
      <div class="rd-sidebar-footer">
        <a href="/landing.html" class="rd-footer-item" target="_blank">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
          <span>Landing Page ↗</span>
        </a>
        <a href="/PHONE_SERVER_GUIDE.md" class="rd-footer-item" target="_blank">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
          </svg>
          <span>Termux Guide</span>
        </a>
        <a href="#" class="rd-footer-item" id="sidebarSleepBtn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="6" y="4" width="4" height="16"></rect>
            <rect x="14" y="4" width="4" height="16"></rect>
          </svg>
          <span>Master Sleep</span>
        </a>
      </div>
    </aside>

    <!-- MAIN APP CANVAS -->
    <div class="rd-main-wrapper">
      
      <!-- TOP HEADER BAR -->
      <header class="rd-topbar">
        <div class="rd-topbar-left">
          <button class="rd-btn-icon-only rd-mobile-toggle" id="mobileMenuBtn" style="margin-right: 8px;">☰</button>
          <div class="rd-topbar-breadcrumb">
            <span id="breadcrumbSection">Overview</span>
            <span style="opacity: 0.4;">/</span>
            <span id="breadcrumbPage" style="font-weight: 500; color: var(--rd-text-main);">Dashboard</span>
          </div>
        </div>

        <div class="rd-topbar-right">
          <!-- Global Search box -->
          <div style="position: relative;">
            <button class="rd-search-trigger" id="globalSearchBtn">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input type="text" id="projectSearchInput" placeholder="Search services..." style="background:transparent; border:none; color:inherit; font-size:12px; outline:none; width:120px;">
              <kbd>^ K</kbd>
            </button>
          </div>

          <!-- Hardware Telemetry Live Pill -->
          <div class="rd-topbar-pill" id="telemetryPill" title="Device Battery, Voltage & CPU Temperature" onclick="switchView('monitoring')" style="cursor: pointer;">
            <span class="rd-live-dot" id="telemetryDot"></span>
            <span id="topbarBattery">--%</span>
            <span class="rd-pill-sep">|</span>
            <span id="topbarTemp">--°C</span>
          </div>

          <!-- Theme Toggle (Light / Dark) -->
          <button class="rd-theme-toggle" id="themeToggleBtn" title="Switch Theme">
            <span id="themeToggleIcon">☀️</span>
            <span id="themeToggleText">Light</span>
          </button>

          <!-- + New Button -->
          <button class="rd-btn-new" id="btnOpenNewProjectModal">
            + New
          </button>

          <!-- User Avatar -->
          <div class="rd-user-avatar" title="Logged in as Admin" onclick="switchView('settings')" style="cursor: pointer;">G</div>
        </div>
      </header>

      <!-- CONTENT BODY -->
      <main class="rd-content-body">
        
        <!-- ==============================================================================
             VIEW 1: DASHBOARD & SYSTEM HEALTH
             ============================================================================== -->
        <div class="rd-view active" id="view-dashboard">
          <div class="rd-page-header">
            <div>
              <h1 class="rd-page-title">Workspace Dashboard</h1>
              <p style="color: var(--rd-text-muted); font-size: 13px; margin-top: 4px;">Real-time system telemetry and production overview on mobile node.</p>
            </div>
            <div style="display: flex; gap: 8px;">
              <button class="rd-mini-btn" onclick="handleMasterSleep()">⏸ Master Sleep</button>
              <button class="rd-btn-new" onclick="openModal('newProjectModal')">+ Create Service</button>
            </div>
          </div>

          <!-- 4 Stats Cards Grid -->
          <div class="rd-stats-grid">
            <!-- Stat 1: Active Services -->
            <div class="rd-stat-card">
              <div class="rd-stat-label">
                <span>Active Services</span>
                <span class="rd-badge rd-badge-success">Live</span>
              </div>
              <div class="rd-stat-val" id="statActiveServices">-- / --</div>
              <div class="rd-stat-sub">
                <span>Total registered projects on node</span>
              </div>
            </div>

            <!-- Stat 2: Phone Battery & Power -->
            <div class="rd-stat-card">
              <div class="rd-stat-label">
                <span>Battery & Power</span>
                <span class="rd-badge rd-badge-success" id="statBatteryStatusBadge">Charging</span>
              </div>
              <div class="rd-stat-val" id="statBatteryVal">--%</div>
              <div class="rd-stat-sub" id="statBatterySub">
                <span>Temp: --°C · Voltage: --</span>
              </div>
              <div class="rd-progress-bar">
                <div class="rd-progress-fill green" id="statBatteryBar" style="width: 50%;"></div>
              </div>
            </div>

            <!-- Stat 3: Memory Utilization -->
            <div class="rd-stat-card">
              <div class="rd-stat-label">
                <span>RAM Utilization</span>
                <span id="statRamPercent">--%</span>
              </div>
              <div class="rd-stat-val" id="statRamVal">-- MB</div>
              <div class="rd-stat-sub" id="statRamSub">
                <span>Free: -- MB of -- MB</span>
              </div>
              <div class="rd-progress-bar">
                <div class="rd-progress-fill" id="statRamBar" style="width: 50%;"></div>
              </div>
            </div>

            <!-- Stat 4: Flash Storage Free -->
            <div class="rd-stat-card">
              <div class="rd-stat-label">
                <span>Storage Space</span>
                <span id="statStoragePercent">--%</span>
              </div>
              <div class="rd-stat-val" id="statStorageVal">-- GB</div>
              <div class="rd-stat-sub" id="statStorageSub">
                <span>Free: -- GB of -- GB</span>
              </div>
              <div class="rd-progress-bar">
                <div class="rd-progress-fill green" id="statStorageBar" style="width: 50%;"></div>
              </div>
            </div>
          </div>

          <!-- Quick Actions & Ingress Summary -->
          <div style="display: grid; grid-template-columns: 2fr 1fr; gap: var(--rd-space-sm); margin-bottom: var(--rd-space-md);">
            <div class="rd-settings-card" style="margin-bottom: 0;">
              <h3 class="rd-settings-card-title">Cloudflare Public Ingress</h3>
              <p class="rd-settings-card-desc">Zero-config encrypted tunnel allowing external HTTPS traffic to your phone without router port-forwarding.</p>
              <div style="display: flex; align-items: center; justify-content: space-between; background: var(--rd-bg-sidebar); border: 1px solid var(--rd-border); border-radius: 6px; padding: 12px 16px;">
                <div>
                  <div style="font-size: 11px; text-transform: uppercase; color: var(--rd-text-sub); font-weight: 600;">Edge Ingress URL</div>
                  <div id="dashTunnelUrl" style="font-family: var(--rd-font-mono); font-size: 13px; font-weight: 500; color: var(--rd-brand-purple); margin-top: 2px;">
                    Tunnel is Standby
                  </div>
                </div>
                <div style="display: flex; gap: 8px;">
                  <button class="rd-mini-btn" id="dashTunnelCopyBtn" onclick="copyDashTunnelUrl()">Copy URL</button>
                  <button class="rd-mini-btn" id="dashTunnelToggleBtn" onclick="toggleTunnelAction()">Start Tunnel</button>
                </div>
              </div>
            </div>

            <div class="rd-settings-card" style="margin-bottom: 0;">
              <h3 class="rd-settings-card-title">Thermal Safety Guard</h3>
              <p class="rd-settings-card-desc">Automatic scale-to-zero when device exceeds 43°C to safeguard Lithium-ion battery.</p>
              <div style="display: flex; align-items: center; gap: 10px; margin-top: 10px;">
                <span class="rd-badge rd-badge-success" id="thermalGuardStatus">Safety Active</span>
                <span style="font-size: 12px; color: var(--rd-text-muted);">Threshold: 43°C</span>
              </div>
            </div>
          </div>

          <!-- Recent Activity Log Section -->
          <div class="rd-settings-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
              <h3 class="rd-settings-card-title" style="margin-bottom: 0;">Recent Platform Activity</h3>
              <button class="rd-mini-btn" onclick="fetchActivity()">Refresh Log</button>
            </div>
            <div class="rd-activity-list" id="dashboardActivityList">
              <p style="color: var(--rd-text-sub); font-size: 12px;">Loading recent events...</p>
            </div>
          </div>
        </div>

        <!-- ==============================================================================
             VIEW 2: PROJECTS & SERVICES MANAGEMENT
             ============================================================================== -->
        <div class="rd-view" id="view-projects">
          <div class="rd-page-header">
            <div>
              <h1 class="rd-page-title">Projects & Services</h1>
              <p style="color: var(--rd-text-muted); font-size: 13px; margin-top: 4px;">Native ARM64 processes running isolated in user space.</p>
            </div>
            <button class="rd-btn-new" onclick="openModal('newProjectModal')">+ New Service</button>
          </div>

          <!-- Tabs for Filtering Projects -->
          <div class="rd-tabs-row" id="projectFilterTabs">
            <button class="rd-tab-pill active" data-filter="all">All Services (<span id="countAll">0</span>)</button>
            <button class="rd-tab-pill" data-filter="running">Running (<span id="countRunning">0</span>)</button>
            <button class="rd-tab-pill" data-filter="stopped">Standby (<span id="countStopped">0</span>)</button>
            <button class="rd-tab-pill" data-filter="web-service">Web Services</button>
            <button class="rd-tab-pill" data-filter="static-site">Static Sites</button>
            <button class="rd-tab-pill" data-filter="api">APIs</button>
          </div>

          <!-- Projects Grid -->
          <div class="rd-projects-grid" id="projectsGrid">
            <div class="rd-loading-card">
              <div class="rd-spinner"></div>
              <p>Connecting to Phone Node...</p>
            </div>
          </div>
        </div>

        <!-- ==============================================================================
             VIEW 3: DEPLOYMENTS & RELEASES
             ============================================================================== -->
        <div class="rd-view" id="view-deployments">
          <div class="rd-page-header">
            <div>
              <h1 class="rd-page-title">Deployments & Releases</h1>
              <p style="color: var(--rd-text-muted); font-size: 13px; margin-top: 4px;">Audit trail of git commits, build outputs, and 1-click rollback releases.</p>
            </div>
            <button class="rd-mini-btn" onclick="fetchDeployments()">Refresh History</button>
          </div>

          <!-- Deployments Table -->
          <div class="rd-table-container">
            <table class="rd-table">
              <thead>
                <tr>
                  <th class="rd-th">Version</th>
                  <th class="rd-th">Service</th>
                  <th class="rd-th">Commit / Message</th>
                  <th class="rd-th">Status</th>
                  <th class="rd-th">Duration</th>
                  <th class="rd-th">Deployed At</th>
                  <th class="rd-th" style="text-align: right;">Actions</th>
                </tr>
              </thead>
              <tbody id="deploymentsTableBody">
                <tr><td colspan="7" class="rd-td" style="text-align: center; color: var(--rd-text-sub);">Loading deployment history...</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- ==============================================================================
             VIEW 4: NETWORKING, DOMAINS & PORTS
             ============================================================================== -->
        <div class="rd-view" id="view-networking">
          <div class="rd-page-header">
            <div>
              <h1 class="rd-page-title">Tunnels, Domains & Ports</h1>
              <p style="color: var(--rd-text-muted); font-size: 13px; margin-top: 4px;">Public Cloudflare ingress, dedicated TCP/HTTP ports, and custom domains.</p>
            </div>
          </div>

          <!-- Tunnel Manager Card -->
          <div class="rd-settings-card">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
              <div>
                <h3 class="rd-settings-card-title">Cloudflare Tunnel Service</h3>
                <p class="rd-settings-card-desc">Expose local services securely over the global Cloudflare Anycast edge.</p>
              </div>
              <span class="rd-badge rd-badge-neutral" id="netTunnelBadge">Disconnected</span>
            </div>

            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 12px; margin-top: 14px;">
              <div>
                <label>Tunnel Mode</label>
                <div style="display: flex; gap: 10px; margin-top: 6px;">
                  <button class="rd-mini-btn active" id="btnTunnelQuickMode" onclick="selectTunnelMode('quick')">Quick Ingress (trycloudflare)</button>
                  <button class="rd-mini-btn" id="btnTunnelTokenMode" onclick="selectTunnelMode('token')">Named Tunnel Token</button>
                </div>
                <div id="tunnelTokenInputWrap" style="display: none; margin-top: 10px;">
                  <label for="tunnelTokenInput">Cloudflare Tunnel Token</label>
                  <input type="password" id="tunnelTokenInput" placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6..." style="margin-top: 4px;">
                </div>
              </div>
              <div style="display: flex; flex-direction: column; justify-content: flex-end; gap: 6px;">
                <button class="rd-btn-new" id="btnStartTunnelNet" onclick="toggleTunnelAction()">Start Cloudflare Tunnel</button>
              </div>
            </div>
          </div>

          <!-- Dedicated Ports Registry Table -->
          <div class="rd-settings-card">
            <h3 class="rd-settings-card-title">Dedicated Port Registry</h3>
            <p class="rd-settings-card-desc">Port allocation table mapped to native ARM64 processes on this node.</p>
            <div class="rd-table-container" style="margin-bottom: 0; margin-top: 10px;">
              <table class="rd-table">
                <thead>
                  <tr>
                    <th class="rd-th">Port</th>
                    <th class="rd-th">Service Name</th>
                    <th class="rd-th">Protocol</th>
                    <th class="rd-th">Status</th>
                    <th class="rd-th">Local Link</th>
                  </tr>
                </thead>
                <tbody id="portsTableBody">
                  <tr><td colspan="5" class="rd-td" style="text-align: center; color: var(--rd-text-sub);">Loading port allocations...</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Custom Domains Manager -->
          <div class="rd-settings-card">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <div>
                <h3 class="rd-settings-card-title">Custom Domains & Subdomains</h3>
                <p class="rd-settings-card-desc">Bind your own domains to services running on this node.</p>
              </div>
              <button class="rd-mini-btn" onclick="openModal('addDomainModal')">+ Add Domain</button>
            </div>
            <div class="rd-table-container" style="margin-bottom: 0; margin-top: 10px;">
              <table class="rd-table">
                <thead>
                  <tr>
                    <th class="rd-th">Domain Name</th>
                    <th class="rd-th">Target Service</th>
                    <th class="rd-th">Port</th>
                    <th class="rd-th">SSL Status</th>
                    <th class="rd-th" style="text-align: right;">Action</th>
                  </tr>
                </thead>
                <tbody id="domainsTableBody">
                  <tr><td colspan="5" class="rd-td" style="text-align: center; color: var(--rd-text-sub);">No custom domains configured.</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ==============================================================================
             VIEW 5: MONITORING, OBSERVABILITY & LOGS
             ============================================================================== -->
        <div class="rd-view" id="view-monitoring">
          <div class="rd-page-header">
            <div>
              <h1 class="rd-page-title">Hardware, Battery & Logs</h1>
              <p style="color: var(--rd-text-muted); font-size: 13px; margin-top: 4px;">Hardware metrics, battery diagnostics, active processes, and log stream.</p>
            </div>
            <button class="rd-mini-btn" onclick="fetchTelemetry(); fetchProcesses();">Refresh Telemetry</button>
          </div>

          <!-- Battery & Physical Health Card -->
          <div class="rd-settings-card">
            <h3 class="rd-settings-card-title">Battery Chemistry & Physical Protection</h3>
            <p class="rd-settings-card-desc">Lithium-ion degradation prevention via thermal monitoring and cyclic power management.</p>
            
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin-top: 14px;">
              <div style="background: var(--rd-bg-sidebar); border: 1px solid var(--rd-border); border-radius: 6px; padding: 12px;">
                <div class="rd-stat-label">Charge Level</div>
                <div style="font-size: 20px; font-weight: 500;" id="monBatteryPct">--%</div>
              </div>
              <div style="background: var(--rd-bg-sidebar); border: 1px solid var(--rd-border); border-radius: 6px; padding: 12px;">
                <div class="rd-stat-label">Temperature</div>
                <div style="font-size: 20px; font-weight: 500;" id="monBatteryTemp">--°C</div>
              </div>
              <div style="background: var(--rd-bg-sidebar); border: 1px solid var(--rd-border); border-radius: 6px; padding: 12px;">
                <div class="rd-stat-label">Cell Voltage</div>
                <div style="font-size: 20px; font-weight: 500;" id="monBatteryVolt">--</div>
              </div>
              <div style="background: var(--rd-bg-sidebar); border: 1px solid var(--rd-border); border-radius: 6px; padding: 12px;">
                <div class="rd-stat-label">Power State</div>
                <div style="font-size: 20px; font-weight: 500;" id="monBatteryStatus">--</div>
              </div>
            </div>
          </div>

          <!-- Active Processes Table -->
          <div class="rd-settings-card">
            <h3 class="rd-settings-card-title">Active Process Monitor</h3>
            <p class="rd-settings-card-desc">Processes spawned directly under the Node control plane in Termux user space.</p>
            <div class="rd-table-container" style="margin-bottom: 0; margin-top: 10px;">
              <table class="rd-table">
                <thead>
                  <tr>
                    <th class="rd-th">PID</th>
                    <th class="rd-th">Process Name</th>
                    <th class="rd-th">Port</th>
                    <th class="rd-th">Uptime</th>
                    <th class="rd-th">Status</th>
                  </tr>
                </thead>
                <tbody id="processesTableBody">
                  <tr><td colspan="5" class="rd-td" style="text-align: center; color: var(--rd-text-sub);">Loading processes...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ==============================================================================
             VIEW 6: DEVELOPER TOOLS (TERMINAL, WEBHOOKS, ENV)
             ============================================================================== -->
        <div class="rd-view" id="view-devtools">
          <div class="rd-page-header">
            <div>
              <h1 class="rd-page-title">Developer Tools</h1>
              <p style="color: var(--rd-text-muted); font-size: 13px; margin-top: 4px;">Interactive command console, continuous Git webhook endpoints, and environment variables studio.</p>
            </div>
          </div>

          <!-- Interactive Developer Console -->
          <div class="rd-settings-card">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <div>
                <h3 class="rd-settings-card-title">Interactive Terminal Console</h3>
                <p class="rd-settings-card-desc">Run non-interactive diagnostic commands directly on the phone host.</p>
              </div>
              <div style="display: flex; gap: 6px;">
                <button class="rd-mini-btn" onclick="runPresetCommand('node -v')">node -v</button>
                <button class="rd-mini-btn" onclick="runPresetCommand('uptime')">uptime</button>
                <button class="rd-mini-btn" onclick="runPresetCommand('free -m')">free -m</button>
                <button class="rd-mini-btn" onclick="runPresetCommand('git status')">git status</button>
              </div>
            </div>

            <div class="rd-terminal-box">
              <div class="rd-terminal-header">
                <span>sh (Termux User Space)</span>
                <span id="termExecDuration">Ready</span>
              </div>
              <div class="rd-terminal-screen" id="devTerminalOutput">Welcome to PhonixPaaS Interactive Console.
Type a command below or click a preset above.</div>
              <form class="rd-terminal-input-row" id="devTerminalForm">
                <span class="rd-terminal-prompt">$</span>
                <input type="text" class="rd-terminal-input" id="devTerminalInput" placeholder="e.g. ps, ls -la, git branch..." autocomplete="off">
                <button type="submit" class="rd-mini-btn" style="border-radius: 0;">Run</button>
              </form>
            </div>
          </div>

          <!-- Continuous Deployment Webhooks -->
          <div class="rd-settings-card">
            <h3 class="rd-settings-card-title">Continuous Git Deployment Webhooks</h3>
            <p class="rd-settings-card-desc">Add these webhook URLs to your GitHub repository settings to trigger automated re-deployment on every git push.</p>
            <div class="rd-table-container" style="margin-bottom: 0; margin-top: 10px;">
              <table class="rd-table">
                <thead>
                  <tr>
                    <th class="rd-th">Service</th>
                    <th class="rd-th">Payload URL</th>
                    <th class="rd-th">Content Type</th>
                    <th class="rd-th">Trigger Event</th>
                    <th class="rd-th" style="text-align: right;">Action</th>
                  </tr>
                </thead>
                <tbody id="webhooksTableBody">
                  <tr><td colspan="5" class="rd-td" style="text-align: center; color: var(--rd-text-sub);">Loading webhooks...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ==============================================================================
             VIEW 7: INFRASTRUCTURE & HARDWARE DIAGNOSTICS
             ============================================================================== -->
        <div class="rd-view" id="view-infrastructure">
          <div class="rd-page-header">
            <div>
              <h1 class="rd-page-title">Node Specs & Hardware Power</h1>
              <p style="color: var(--rd-text-muted); font-size: 13px; margin-top: 4px;">Hardware diagnostics, Android WakeLock status, and power-saving thresholds.</p>
            </div>
          </div>

          <!-- Hardware Diagnostics Spec Table -->
          <div class="rd-settings-card">
            <h3 class="rd-settings-card-title">Node Diagnostics</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin-top: 14px;">
              <div style="background: var(--rd-bg-sidebar); border: 1px solid var(--rd-border); border-radius: 6px; padding: 12px;">
                <div class="rd-stat-label">Architecture</div>
                <div style="font-size: 14px; font-weight: 500;" id="infraArch">--</div>
              </div>
              <div style="background: var(--rd-bg-sidebar); border: 1px solid var(--rd-border); border-radius: 6px; padding: 12px;">
                <div class="rd-stat-label">CPU Cores & Model</div>
                <div style="font-size: 14px; font-weight: 500;" id="infraCpu">--</div>
              </div>
              <div style="background: var(--rd-bg-sidebar); border: 1px solid var(--rd-border); border-radius: 6px; padding: 12px;">
                <div class="rd-stat-label">Operating System</div>
                <div style="font-size: 14px; font-weight: 500;" id="infraOs">--</div>
              </div>
              <div style="background: var(--rd-bg-sidebar); border: 1px solid var(--rd-border); border-radius: 6px; padding: 12px;">
                <div class="rd-stat-label">Node Runtime</div>
                <div style="font-size: 14px; font-weight: 500;" id="infraNode">--</div>
              </div>
            </div>
          </div>

          <!-- Android WakeLock Card -->
          <div class="rd-settings-card">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <div>
                <h3 class="rd-settings-card-title">Android CPU WakeLock</h3>
                <p class="rd-settings-card-desc">Prevents aggressive Android OEM battery savers from putting the CPU into deep sleep when the screen turns off.</p>
              </div>
              <label class="rd-switch">
                <input type="checkbox" id="infraWakeLockToggle" onchange="toggleWakeLockAction(this.checked)">
                <span class="rd-slider"></span>
              </label>
            </div>
            <div style="font-size: 12px; color: var(--rd-text-sub); margin-top: 10px;">
              Status: <span id="infraWakeLockText" style="font-weight: 600;">Disabled</span> (Recommended: Keep enabled for 24/7 background hosting).
            </div>
          </div>
        </div>

        <!-- ==============================================================================
             VIEW 8: INTEGRATIONS & CONNECTORS
             ============================================================================== -->
        <div class="rd-view" id="view-integrations">
          <div class="rd-page-header">
            <div>
              <h1 class="rd-page-title">Integrations & Connectors</h1>
              <p style="color: var(--rd-text-muted); font-size: 13px; margin-top: 4px;">Connect external services, Cloudflare Zero Trust, and external databases.</p>
            </div>
          </div>

          <!-- Cloudflare Zero Trust Integration -->
          <div class="rd-settings-card">
            <h3 class="rd-settings-card-title">Cloudflare Zero Trust & Tunnels</h3>
            <p class="rd-settings-card-desc">Configure persistent Cloudflare tunnel credentials to attach custom domains with automated SSL renewal.</p>
            <div class="rd-form-group" style="margin-top: 12px;">
              <label for="integCloudflareToken">Cloudflare Tunnel Token</label>
              <input type="password" id="integCloudflareToken" placeholder="Paste Tunnel Token from Cloudflare Zero Trust Dashboard">
            </div>
            <button class="rd-btn-new" onclick="saveCloudflareToken()">Save Tunnel Token</button>
          </div>

          <!-- External Database Connectors -->
          <div class="rd-settings-card">
            <h3 class="rd-settings-card-title">Database Integrations</h3>
            <p class="rd-settings-card-desc">PhonixPaaS supports embedded JSON atomic databases, native Termux SQLite, or external remote databases.</p>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; margin-top: 12px;">
              <div style="border: 1px solid var(--rd-border); border-radius: 6px; padding: 14px; background: var(--rd-bg-sidebar);">
                <div style="font-weight: 600; font-size: 14px;">Atomic JSON Engine</div>
                <div style="font-size: 12px; color: var(--rd-text-muted); margin-top: 4px;">Zero RAM overhead, safe write-ahead atomic swaps for low-power operation.</div>
                <span class="rd-badge rd-badge-success" style="margin-top: 8px;">Active Default</span>
              </div>
              <div style="border: 1px solid var(--rd-border); border-radius: 6px; padding: 14px; background: var(--rd-bg-sidebar);">
                <div style="font-weight: 600; font-size: 14px;">SQLite Native Engine</div>
                <div style="font-size: 12px; color: var(--rd-text-muted); margin-top: 4px;">Full ACID transactional database without background server daemons. Run <code>pkg install sqlite</code>.</div>
                <span class="rd-badge rd-badge-neutral" style="margin-top: 8px;">Supported</span>
              </div>
            </div>
          </div>
        </div>

        <!-- ==============================================================================
             VIEW 9: PLATFORM SETTINGS & DISASTER RECOVERY
             ============================================================================== -->
        <div class="rd-view" id="view-settings">
          <div class="rd-page-header">
            <div>
              <h1 class="rd-page-title">Platform Settings & Security</h1>
              <p style="color: var(--rd-text-muted); font-size: 13px; margin-top: 4px;">Workspace configuration, administrative security, and database backup restoration.</p>
            </div>
          </div>

          <!-- General Workspace Settings -->
          <div class="rd-settings-card">
            <h3 class="rd-settings-card-title">Workspace Preferences</h3>
            <form id="settingsGeneralForm" onsubmit="handleSaveGeneralSettings(event)">
              <div class="rd-form-row">
                <div class="rd-form-group">
                  <label for="setWorkspaceName">Workspace Name</label>
                  <input type="text" id="setWorkspaceName" value="My Workspace" required>
                </div>
                <div class="rd-form-group">
                  <label for="setDashboardPort">Control Plane Port</label>
                  <input type="number" id="setDashboardPort" value="4000" required>
                </div>
              </div>
              <button type="submit" class="rd-btn-new">Save Workspace Settings</button>
            </form>
          </div>

          <!-- Admin Security & API Keys -->
          <div class="rd-settings-card">
            <h3 class="rd-settings-card-title">Administrative Security</h3>
            <p class="rd-settings-card-desc">Require an API Key for remote administrative actions (POST, PUT, DELETE) when managing your phone over the web.</p>
            <div class="rd-form-group">
              <label for="setAdminApiKey">Admin Secret Key (Leave blank to disable auth)</label>
              <input type="password" id="setAdminApiKey" placeholder="Set a secret token...">
            </div>
            <button class="rd-btn-new" onclick="handleSaveSecuritySettings()">Update Security Key</button>
          </div>

          <!-- Backup & Disaster Recovery -->
          <div class="rd-settings-card">
            <h3 class="rd-settings-card-title">Backup & Disaster Recovery</h3>
            <p class="rd-settings-card-desc">Download a snapshot of all services, deployments, and configurations, or reset to factory defaults.</p>
            <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px;">
              <a href="/api/backup/export" class="rd-btn-new" download style="text-decoration: none;">Export Backup (JSON)</a>
              <button class="rd-mini-btn" onclick="document.getElementById('importBackupFile').click()">Restore From Backup</button>
              <input type="file" id="importBackupFile" accept=".json" style="display: none;" onchange="handleImportBackup(event)">
              <button class="rd-mini-btn" style="color: #ef4444;" onclick="handleFactoryReset()">Factory Reset Database</button>
            </div>
          </div>

          <!-- About Card -->
          <div class="rd-settings-card">
            <h3 class="rd-settings-card-title">About PhonixPaaS</h3>
            <p style="font-size: 13px; color: var(--rd-text-muted); line-height: 1.6;">
              PhonixPaaS transforms recycled smartphones and low-power ARM64 devices into self-hosted cloud hosting nodes.<br>
              Architecture: Dockerless POSIX user space · Memory footprint: &lt;35MB RAM · Native process isolation.
            </p>
          </div>
        </div>

      </main>

      <!-- FLOATING FEEDBACK BUTTON -->
      <div class="rd-feedback-btn" onclick="switchView('settings')">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <span>Phonix Node</span>
      </div>

    </div>
  </div>

  <!-- MODAL: CREATE NEW PROJECT -->
  <div class="rd-modal-backdrop" id="newProjectModal">
    <div class="rd-modal">
      <div class="rd-modal-header">
        <div>
          <h3>Create a New Service</h3>
          <p class="rd-modal-subtitle">Deploy a web service or static site directly onto this phone.</p>
        </div>
        <button class="rd-modal-close" onclick="closeModal('newProjectModal')">&times;</button>
      </div>

      <form id="newProjectForm">
        <div class="rd-form-group">
          <label for="projectName">Service Name *</label>
          <input type="text" id="projectName" placeholder="e.g. portfolio-api" required>
        </div>

        <div class="rd-form-group">
          <label for="projectCategory">Service Type</label>
          <select id="projectCategory" style="width: 100%; padding: 8px 10px; background: var(--rd-bg-root); border: 1px solid var(--rd-border); border-radius: var(--rd-btn-radius); color: var(--rd-text-main); font-family: var(--rd-font-body); font-size: 13px;">
            <option value="web-service">Web Service (Node.js / Express / Fastify)</option>
            <option value="static-site">Static Site (HTML / CSS / JS)</option>
            <option value="api">Backend REST / GraphQL API</option>
            <option value="worker">Background Worker</option>
          </select>
        </div>

        <div class="rd-form-group">
          <label for="gitUrl">Git Repository URL (Optional)</label>
          <input type="url" id="gitUrl" placeholder="https://github.com/username/project.git">
          <span class="rd-form-hint">Leave blank to create a clean template.</span>
        </div>

        <div class="rd-form-row">
          <div class="rd-form-group">
            <label for="gitBranch">Branch</label>
            <input type="text" id="gitBranch" value="main">
          </div>
          <div class="rd-form-group">
            <label for="projectPort">Port (Auto-assigned if empty)</label>
            <input type="number" id="projectPort" placeholder="e.g. 3001">
          </div>
        </div>

        <div class="rd-form-group">
          <label for="buildCmd">Build Command</label>
          <input type="text" id="buildCmd" placeholder="npm install">
        </div>

        <div class="rd-form-group">
          <label for="startCmd">Start Command</label>
          <input type="text" id="startCmd" value="npm start">
        </div>

        <div class="rd-modal-footer">
          <button type="button" class="rd-btn-modal-cancel" onclick="closeModal('newProjectModal')">Cancel</button>
          <button type="submit" class="rd-btn-modal-submit" id="btnSubmitProject">Create Service</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: ADD CUSTOM DOMAIN -->
  <div class="rd-modal-backdrop" id="addDomainModal">
    <div class="rd-modal">
      <div class="rd-modal-header">
        <div>
          <h3>Add Custom Domain</h3>
          <p class="rd-modal-subtitle">Route a public hostname to a local port or service.</p>
        </div>
        <button class="rd-modal-close" onclick="closeModal('addDomainModal')">&times;</button>
      </div>

      <form id="addDomainForm" onsubmit="handleAddDomainSubmit(event)">
        <div class="rd-form-group">
          <label for="newDomainName">Domain / Subdomain *</label>
          <input type="text" id="newDomainName" placeholder="e.g. api.mydomain.com" required>
        </div>

        <div class="rd-form-group">
          <label for="newDomainService">Target Service *</label>
          <select id="newDomainService" style="width: 100%; padding: 8px 10px; background: var(--rd-bg-root); border: 1px solid var(--rd-border); border-radius: var(--rd-btn-radius); color: var(--rd-text-main); font-family: var(--rd-font-body); font-size: 13px;" required>
            <!-- Injected dynamically -->
          </select>
        </div>

        <div class="rd-modal-footer">
          <button type="button" class="rd-btn-modal-cancel" onclick="closeModal('addDomainModal')">Cancel</button>
          <button type="submit" class="rd-btn-modal-submit">Bind Domain</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: LOGS VIEWER -->
  <div class="rd-modal-backdrop" id="logsModal">
    <div class="rd-modal rd-modal-lg">
      <div class="rd-modal-header">
        <div>
          <h3 id="logsModalTitle">Service Logs</h3>
          <p class="rd-modal-subtitle" id="logsModalSubtitle">Streaming standard output...</p>
        </div>
        <div class="rd-modal-header-actions" style="display: flex; gap: 8px; align-items: center;">
          <button class="rd-mini-btn" onclick="copyModalLogs()">Copy Logs</button>
          <button class="rd-mini-btn" onclick="refreshCurrentLogs()">Refresh</button>
          <button class="rd-modal-close" onclick="closeModal('logsModal')">&times;</button>
        </div>
      </div>
      <div class="rd-terminal-body" id="terminalOutput">
        <!-- Terminal lines -->
      </div>
    </div>
  </div>

  <!-- MODAL: ENV VARIABLES -->
  <div class="rd-modal-backdrop" id="envModal">
    <div class="rd-modal">
      <div class="rd-modal-header">
        <div>
          <h3 id="envModalTitle">Environment Variables</h3>
          <p class="rd-modal-subtitle">Variables injected into process.env on boot</p>
        </div>
        <button class="rd-modal-close" onclick="closeModal('envModal')">&times;</button>
      </div>
      <div class="rd-env-editor">
        <div id="envRowsContainer">
          <!-- Dynamic key-values -->
        </div>
        <button type="button" class="rd-btn-modal-cancel" style="margin-top: 0.5rem;" onclick="addEnvRow()">
          + Add Variable
        </button>
      </div>
      <div class="rd-modal-footer">
        <button type="button" class="rd-btn-modal-cancel" onclick="closeModal('envModal')">Cancel</button>
        <button type="button" class="rd-btn-modal-submit" onclick="saveCurrentEnv()">Save Variables</button>
      </div>
    </div>
  </div>

  <script src="js/app.js"></script>
</body>
</html>